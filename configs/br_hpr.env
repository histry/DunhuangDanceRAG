# State-aware BR-HPR: global reachability under low-resource safe-set scarcity.
# Physical, anatomy and severe-heading gates remain immutable.

BR_HPR_ENABLE=1
BR_HPR_CONTROLLED_RECOVERY_ENABLE=1

# Hierarchical Event geometry
BR_HPR_HYPERBOLIC_DIMENSION=8
BR_HPR_HYPERBOLIC_MAXIMUM_RADIUS=0.82
BR_HPR_HIERARCHY_TEMPERATURE=1.25
BR_HPR_HIERARCHY_RECENCY_DECAY=3.0
BR_HPR_HIERARCHY_SIMILARITY_TARGET=0.55

# Preference reference values
BR_HPR_EVENT_COOLDOWN_SLOTS=8
BR_HPR_MAX_SOURCE_RUN=2
BR_HPR_MAX_SOURCE_SHARE=0.40
BR_HPR_MAX_FAMILY_SHARE=0.50
BR_HPR_MIN_SHARE_HISTORY=6
BR_HPR_OBSERVABILITY_TARGET=0.45

# Song-level normalized violation budgets
BR_HPR_EVENT_REPEAT_BUDGET=1.10
BR_HPR_SOURCE_RUN_BUDGET=0.75
BR_HPR_SOURCE_SHARE_BUDGET=0.75
BR_HPR_FAMILY_SHARE_BUDGET=0.90
BR_HPR_OBSERVABILITY_BUDGET=0.75
BR_HPR_HIERARCHY_REPETITION_BUDGET=1.50

# Probabilistic preference weights
BR_HPR_EVENT_REPEAT_WEIGHT=1.20
BR_HPR_SOURCE_RUN_WEIGHT=1.00
BR_HPR_SOURCE_SHARE_WEIGHT=0.80
BR_HPR_FAMILY_SHARE_WEIGHT=0.65
BR_HPR_OBSERVABILITY_WEIGHT=0.60
BR_HPR_HIERARCHY_REPETITION_WEIGHT=0.90
BR_HPR_FUTURE_REACHABILITY_WEIGHT=0.75
BR_HPR_DUAL_LEARNING_RATE=0.25
BR_HPR_BUDGET_TOLERANCE=0.000001

# Scarcity-aware source budgets. Raw violations remain in the report; only their
# effective preference cost is scaled when no alternative hard-safe source exists.
BR_HPR_SOURCE_SCARCITY_ENABLE=1
BR_HPR_MINIMUM_SAFE_SOURCE_COUNT=2
BR_HPR_SOURCE_SCARCITY_MINIMUM_SCALE=0.12
BR_HPR_SOURCE_SCARCITY_BUDGET_CREDIT=0.25

# Continuous controlled recovery resource
BR_HPR_RECOVERY_PENALTY=4.0
BR_HPR_RECOVERY_TOPK=2
BR_HPR_RECOVERY_BUDGET_TOTAL=3.00
BR_HPR_RECOVERY_MINIMUM_CHARGE=0.05
BR_HPR_RECOVERY_MAXIMUM_CHARGE_PER_SLOT=0.90
BR_HPR_RECOVERY_EVENT_REPEAT_WEIGHT=1.00
BR_HPR_RECOVERY_SOURCE_RUN_WEIGHT=0.65
BR_HPR_RECOVERY_SOURCE_SHARE_WEIGHT=0.45
BR_HPR_RECOVERY_FAMILY_SHARE_WEIGHT=0.55
BR_HPR_RECOVERY_OBSERVABILITY_WEIGHT=0.50
BR_HPR_RECOVERY_HIERARCHY_WEIGHT=0.55

# Static and state-conditioned backward reachability
BR_HPR_REACHABILITY_HIERARCHY_WEIGHT=0.55
BR_HPR_REACHABILITY_SAME_EVENT_PENALTY=1.20
BR_HPR_REACHABILITY_SAME_SOURCE_PENALTY=0.30
BR_HPR_REACHABILITY_SAME_FAMILY_PENALTY=0.20
BR_HPR_REACHABILITY_SOURCE_TRANSITION_WEIGHT=0.35
BR_HPR_REACHABILITY_RANK_WEIGHT=0.02
BR_HPR_REACHABILITY_MAXIMUM_EDGE_COST=8.0
BR_HPR_REACHABILITY_ANATOMY_QUALITY_MIN=0.30
BR_HPR_REACHABILITY_PROBABILITY_FLOOR=0.000001
BR_HPR_STATE_REACHABILITY_HORIZON=4
BR_HPR_STATE_REACHABILITY_BRANCH_TOPK=6
BR_HPR_STATE_REACHABILITY_HISTORY_WINDOW=8
BR_HPR_STATE_REACHABILITY_USAGE_QUANTIZATION=0.05
BR_HPR_STATE_REACHABILITY_RECOVERY_QUANTIZATION=0.05
BR_HPR_STATE_REACHABILITY_OBSERVABILITY=0.70
BR_HPR_STATE_REACHABILITY_CACHE_MAXIMUM_ENTRIES=20000

# Source-targeted candidate reservoir and bounded exact expansion
BR_HPR_SOURCE_COVERAGE_ENABLE=1
BR_HPR_SOURCE_RESERVOIR_MAXIMUM_PER_SLOT=24
BR_HPR_SOURCE_RESERVOIR_PER_SOURCE=3
BR_HPR_SOURCE_EXPANSION_MAXIMUM_EXACT=8
BR_HPR_SOURCE_EXPANSION_PER_SOURCE=2
BR_HPR_SOURCE_EXPANSION_ANATOMY_MIN=0.30
BR_HPR_SOURCE_EXPANSION_QUALITY_WEIGHT=0.55
BR_HPR_SOURCE_EXPANSION_ANATOMY_WEIGHT=0.45
BR_HPR_SOURCE_EXPANSION_HEADING_WEIGHT=0.25
BR_HPR_SOURCE_EXPANSION_DURATION_WEIGHT=0.35
BR_HPR_SOURCE_EXPANSION_FAMILY_AFFINITY_WEIGHT=0.30
BR_HPR_SOURCE_EXPANSION_HIERARCHY_WEIGHT=0.20
BR_HPR_SOURCE_EXPANSION_HISTORY_NOVELTY_WEIGHT=0.20
