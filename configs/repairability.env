# Repairability is opt-in.  Sourcing this file alone never changes selection.
export REPAIRABILITY_MODE="${REPAIRABILITY_MODE:-off}"
export REPAIRABILITY_CHECKPOINT="${REPAIRABILITY_CHECKPOINT:-}"
export REPAIRABILITY_DEVICE="${REPAIRABILITY_DEVICE:-cpu}"
export REPAIRABILITY_SPLIT_ISOLATION="${REPAIRABILITY_SPLIT_ISOLATION:-all}"

# Passive trace metadata.  Enable for paired baseline/shadow/rank evaluation;
# it does not enter retrieval, generation, repair or Guard decisions.
export GAR_EVALUATION_TRACE_ENABLE="${GAR_EVALUATION_TRACE_ENABLE:-0}"
export GAR_EVALUATION_METHOD_VARIANT_ID="${GAR_EVALUATION_METHOD_VARIANT_ID:-current_boundary_closed_loop}"

# Exhaustive, resumable Outcome Bank capture.  Enable only on the 4090 because
# every candidate/seed pair executes the full downstream generator and Guard.
export GAR_OUTCOME_BANK_ENABLE="${GAR_OUTCOME_BANK_ENABLE:-0}"
export GAR_OUTCOME_BANK_PATH="${GAR_OUTCOME_BANK_PATH:-}"
export GAR_OUTCOME_BANK_SEEDS="${GAR_OUTCOME_BANK_SEEDS:-42,43,44,45}"
export GAR_OUTCOME_BANK_TOPK="${GAR_OUTCOME_BANK_TOPK:-32}"
export GAR_OUTCOME_BANK_MAX_TRIALS="${GAR_OUTCOME_BANK_MAX_TRIALS:-4096}"
