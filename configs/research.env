export RETARGET_HEAD_ABOVE_RATIO_MIN="$GRAVITY_HEAD_ABOVE_RATIO_MIN"
export RETARGET_FEET_BELOW_RATIO_MIN="$GRAVITY_FEET_BELOW_RATIO_MIN"
export RETARGET_HORIZONTAL_BODY_RATIO_MAX="$GRAVITY_HORIZONTAL_BODY_RATIO_MAX"

# ---------- Geometry-Aware Routing grounding / routing / local repair ----------
export GROUNDING_ENABLE=1
