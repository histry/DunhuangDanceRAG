export SEMANTIC_OT_CROSS_PHRASE_TEMPERATURE="${SEMANTIC_OT_CROSS_PHRASE_TEMPERATURE:-0.25}"

# MOTION_ACTIVITY_INTEGRATION_BEGIN
# Activity diagnostics and anti-collapse acceptance.  These checks are additive
# and never relax physical, anatomy or severe-heading hard gates.
export MOTION_ACTIVITY_CANDIDATE_HARD_GATE=${MOTION_ACTIVITY_CANDIDATE_HARD_GATE:-1}
