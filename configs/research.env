export GROUNDING_GLOBAL_ROOT_VEL_W="${GROUNDING_GLOBAL_ROOT_VEL_W:-0.30}"
# ---------- Graph Route paper-two Fisher-Rao Graph-SB route ----------
# The code-level default remains legacy_beam for old deployments; the research
# profile explicitly opts into the time-expanded categorical path solver.
export GRAPH_ROUTE_SOLVER="${GRAPH_ROUTE_SOLVER:-fisher_rao_graph_sb}"
export GRAPH_ROUTE_FR_TEMPERATURE="${GRAPH_ROUTE_FR_TEMPERATURE:-0.65}"
