unset GENERATION_FIXED_DURATION_SECONDS || true

# ---------- semantic optimal-transport weak supervision ----------
_SEMANTIC_OT_ENABLE_DEFAULT=0
[[ "$EXPERIMENT_PROFILE" != "semantic_ot" ]] || _SEMANTIC_OT_ENABLE_DEFAULT=1
export SEMANTIC_OT_ENABLE="${SEMANTIC_OT_ENABLE:-$_SEMANTIC_OT_ENABLE_DEFAULT}"
