export MOTION_ACTIVITY_HIGH_TARGET_FAILED_FRACTION=${MOTION_ACTIVITY_HIGH_TARGET_FAILED_FRACTION:-0.34}
# MOTION_ACTIVITY_INTEGRATION_END
