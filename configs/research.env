export MOTION_ACTIVITY_FINAL_MAX_STATIC_RATIO=0.62
export MOTION_ACTIVITY_FINAL_MAX_STATIC_SECONDS=2.0
export MOTION_ACTIVITY_FINAL_MIN_JOINT_RADPS=0.08
export MOTION_ACTIVITY_FINAL_MIN_ROOT_TRAVEL_MPS=${MOTION_ACTIVITY_FINAL_MIN_ROOT_TRAVEL_MPS:-0.012}
export MOTION_ACTIVITY_FINAL_MIN_FK_VISIBLE_MPS=${MOTION_ACTIVITY_FINAL_MIN_FK_VISIBLE_MPS:-0.020}
# Visible motion is measured after this physical-time low-pass so alternating
# high-frequency joint jitter cannot satisfy Anti-Freeze/Anti-Collapse.
export MOTION_ACTIVITY_SUSTAINED_FILTER_SECONDS=${MOTION_ACTIVITY_SUSTAINED_FILTER_SECONDS:-0.20}
export MOTION_ACTIVITY_FINAL_WINDOW_SECONDS=${MOTION_ACTIVITY_FINAL_WINDOW_SECONDS:-1.0}
export MOTION_ACTIVITY_FINAL_WINDOW_HOP_SECONDS=${MOTION_ACTIVITY_FINAL_WINDOW_HOP_SECONDS:-0.5}
export MOTION_ACTIVITY_FINAL_MIN_WINDOW_AMPLITUDE_M=${MOTION_ACTIVITY_FINAL_MIN_WINDOW_AMPLITUDE_M:-0.020}
export MOTION_ACTIVITY_FINAL_MAX_LOW_AMPLITUDE_WINDOW_RATIO=${MOTION_ACTIVITY_FINAL_MAX_LOW_AMPLITUDE_WINDOW_RATIO:-0.60}
export MOTION_ACTIVITY_HIGH_TARGET_THRESHOLD=${MOTION_ACTIVITY_HIGH_TARGET_THRESHOLD:-0.55}
export MOTION_ACTIVITY_HIGH_TARGET_MAX_STATIC_RATIO=${MOTION_ACTIVITY_HIGH_TARGET_MAX_STATIC_RATIO:-0.75}
