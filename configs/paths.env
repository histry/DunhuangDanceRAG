#!/usr/bin/env bash
# Internal path fragment. Source configs/experiment.env, never this file.
# Main contains only the Chang-E official-SMPL formal protocol. Historical
# BVH assets and checkpoints are recoverable from the archive Git tag.
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PYTHON_BIN="${PYTHON_BIN:-python}"
export TRAIN_MUSIC_DIR="$PROJECT_ROOT/assets/music/train"
export CLASSICAL_EVAL_DIR="$PROJECT_ROOT/assets/music/classical_eval"
export TEST_AUDIO="$PROJECT_ROOT/assets/music/test/audio/dunhuangwu2.wav"

export ROOT_DIR="$PROJECT_ROOT"
export GENERATION_PYTHON="${GENERATION_PYTHON:-$PYTHON_BIN}"
export MUSIC_DIRS="${MUSIC_DIRS:-$TRAIN_MUSIC_DIR}"
export AUDIO="${AUDIO:-$TEST_AUDIO}"

# Formal assets are built inside OUT_ROOT by scripts/pipeline.sh. Empty
# defaults prevent old repository checkpoints from becoming hidden priors.
export GENERATION_ROUTER_CKPT="${GENERATION_ROUTER_CKPT:-}"
export GENERATION_PLANNER_CKPT="${GENERATION_PLANNER_CKPT:-}"
export GENERATION_DURATION_CKPT="${GENERATION_DURATION_CKPT:-}"
export GENERATION_INDEX_JSON="${GENERATION_INDEX_JSON:-}"
export GENERATION_DURATION_INDEX_NPZ="${GENERATION_DURATION_INDEX_NPZ:-}"
export GENERATION_HIERARCHY_INDEX_NPZ="${GENERATION_HIERARCHY_INDEX_NPZ:-}"
export GENERATION_START_POSE="${GENERATION_START_POSE:-}"
export RETARGET_CLEAN_ALLOW_SOFT_ROOT_CONTRACT=1
