#!/usr/bin/env bash
# Single authoritative configuration entry for every repository launcher.
#
# Public contract: source configs/experiment.env
#
# The files loaded below are internal, topic-scoped fragments. Launchers must
# never source them directly; this entry fixes their order and override policy.

_EXPERIMENT_CONFIG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export EXPERIMENT_PROFILE="research"

# shellcheck disable=SC1091
source "$_EXPERIMENT_CONFIG_DIR/paths.env"

# Formal training is pinned to the complete 14-source Chang-E Aligned SMPL bundle.
# Do not inherit stale interactive-shell paths from the historical SMPL/BVH
# routes.  Alternative datasets belong behind an explicit ablation launcher.
export CHANG_E_OFFICIAL_SMPL_DIR="$PROJECT_ROOT/assets/motion/smpl_official_14"
export CHANG_E_OFFICIAL_SMPL_MANIFEST="$CHANG_E_OFFICIAL_SMPL_DIR/sources.json"
export CHANG_E_REQUIRE_OFFICIAL_SMPL_MANIFEST="${CHANG_E_REQUIRE_OFFICIAL_SMPL_MANIFEST:-1}"

# shellcheck disable=SC1091
source "$_EXPERIMENT_CONFIG_DIR/scheduler.env"
# shellcheck disable=SC1091
source "$_EXPERIMENT_CONFIG_DIR/research.env"
# shellcheck disable=SC1091
source "$_EXPERIMENT_CONFIG_DIR/research_feasibility.env"
# shellcheck disable=SC1091
source "$_EXPERIMENT_CONFIG_DIR/performer_policy.env"

export EXPERIMENT_CONFIG_LOADED=1
export EXPERIMENT_ACTIVE_PROFILE="research"
unset _EXPERIMENT_CONFIG_DIR
