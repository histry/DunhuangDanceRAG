# Weakly supervised MSSD-AESD semantic optimal-transport configuration.
# Source configs/research.env first, then source this file.

export SEMANTIC_OT_ENABLE=1
export SEMANTIC_OT_SEED="${SEMANTIC_OT_SEED:-20260724}"
export SEMANTIC_OT_MUSIC_TRAIN_RATIO="${SEMANTIC_OT_MUSIC_TRAIN_RATIO:-0.80}"
export SEMANTIC_OT_MUSIC_VALIDATION_RATIO="${SEMANTIC_OT_MUSIC_VALIDATION_RATIO:-0.10}"
# Phrase intervals come from structural novelty/beat boundaries, not equal chunks.
export SEMANTIC_OT_MIN_PHRASE_SECONDS="${SEMANTIC_OT_MIN_PHRASE_SECONDS:-1.6}"
export SEMANTIC_OT_MAX_PHRASE_SECONDS="${SEMANTIC_OT_MAX_PHRASE_SECONDS:-7.5}"
export SEMANTIC_OT_BOUNDARY_QUANTILE="${SEMANTIC_OT_BOUNDARY_QUANTILE:-0.68}"
export SEMANTIC_OT_BEAT_SNAP_SECONDS="${SEMANTIC_OT_BEAT_SNAP_SECONDS:-0.35}"
export SEMANTIC_OT_MUSIC_PRIOR_ALPHA="${SEMANTIC_OT_MUSIC_PRIOR_ALPHA:-0.25}"
export SEMANTIC_OT_TEACHER_FRAMES="${SEMANTIC_OT_TEACHER_FRAMES:-1800}"
export SEMANTIC_OT_TEACHER_EPOCHS="${SEMANTIC_OT_TEACHER_EPOCHS:-80}"
export SEMANTIC_OT_TEACHER_BATCH="${SEMANTIC_OT_TEACHER_BATCH:-256}"
export SEMANTIC_OT_FREEZE_MUSIC_ENCODER="${SEMANTIC_OT_FREEZE_MUSIC_ENCODER:-1}"

export SEMANTIC_OT_PRIOR_ALPHA="${SEMANTIC_OT_PRIOR_ALPHA:-0.35}"
export SEMANTIC_OT_AMBIGUITY_MARGIN="${SEMANTIC_OT_AMBIGUITY_MARGIN:-0.08}"
export SEMANTIC_OT_INTRINSIC_LOW="${SEMANTIC_OT_INTRINSIC_LOW:-0.35}"
export SEMANTIC_OT_INTRINSIC_HIGH="${SEMANTIC_OT_INTRINSIC_HIGH:-0.65}"

export SEMANTIC_OT_TOP_K="${SEMANTIC_OT_TOP_K:-8}"
export SEMANTIC_OT_PRESELECT_K="${SEMANTIC_OT_PRESELECT_K:-64}"
export SEMANTIC_OT_PRESELECT_PER_SOURCE="${SEMANTIC_OT_PRESELECT_PER_SOURCE:-8}"
export SEMANTIC_OT_SINKHORN_EPSILON="${SEMANTIC_OT_SINKHORN_EPSILON:-0.08}"
export SEMANTIC_OT_SINKHORN_ITERATIONS="${SEMANTIC_OT_SINKHORN_ITERATIONS:-200}"

export SEMANTIC_OT_GROUNDER_EPOCHS="${SEMANTIC_OT_GROUNDER_EPOCHS:-120}"
export SEMANTIC_OT_BATCH_PHRASES="${SEMANTIC_OT_BATCH_PHRASES:-12}"
export SEMANTIC_OT_GROUNDER_PATIENCE="${SEMANTIC_OT_GROUNDER_PATIENCE:-20}"
export SEMANTIC_OT_CALIBRATE_RISK="${SEMANTIC_OT_CALIBRATE_RISK:-1}"

# Existing mixed-grounder dimensions remain authoritative.
export V46_53_MIXED_GROUNDER_CUDA="${V46_53_MIXED_GROUNDER_CUDA:-1}"
export V46_53_MIXED_GROUNDER_INFER_CUDA="${V46_53_MIXED_GROUNDER_INFER_CUDA:-1}"
export SEMANTIC_OT_DIVERSITY_TOP_K="${SEMANTIC_OT_DIVERSITY_TOP_K:-20}"
export SEMANTIC_OT_SOURCE_CAP="${SEMANTIC_OT_SOURCE_CAP:-3}"
export SEMANTIC_OT_FAMILY_CAP="${SEMANTIC_OT_FAMILY_CAP:-6}"
export SEMANTIC_OT_MIN_CLASS_CAP="${SEMANTIC_OT_MIN_CLASS_CAP:-2}"
export SEMANTIC_OT_PREVIOUS_INTRINSIC_W="${SEMANTIC_OT_PREVIOUS_INTRINSIC_W:-0.10}"
export SEMANTIC_OT_FOLLOWING_INTRINSIC_W="${SEMANTIC_OT_FOLLOWING_INTRINSIC_W:-0.10}"
export SEMANTIC_OT_PAIRWISE_RISK_W="${SEMANTIC_OT_PAIRWISE_RISK_W:-0.80}"
export SEMANTIC_OT_REPAIR_LOW="${SEMANTIC_OT_REPAIR_LOW:-0.35}"
export SEMANTIC_OT_REPAIR_HIGH="${SEMANTIC_OT_REPAIR_HIGH:-0.70}"
export SEMANTIC_OT_REPAIR_RESIDUAL_HIGH="${SEMANTIC_OT_REPAIR_RESIDUAL_HIGH:-0.55}"
export SEMANTIC_OT_CROSS_PHRASE_TARGET_W="${SEMANTIC_OT_CROSS_PHRASE_TARGET_W:-0.15}"
export SEMANTIC_OT_CROSS_PHRASE_TEMPERATURE="${SEMANTIC_OT_CROSS_PHRASE_TEMPERATURE:-0.25}"
