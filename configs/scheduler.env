# =============================================================================
# Fresh-WAV schedule transaction + event-heading contract
# =============================================================================
# Internal scheduler fragment. Source configs/experiment.env, never this file.

_PROJECT_ROOT="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export EDGE_ROOT="$_PROJECT_ROOT"
export PYTHONPATH="$_PROJECT_ROOT"
unset _PROJECT_ROOT
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export MOTION_DEVICE="${MOTION_DEVICE:-cuda}"
export SOURCE_RETARGET_DEVICE="${SOURCE_RETARGET_DEVICE:-cuda}"
# One externally selectable canonical rate drives both retargeting and scheduling.
export GENERATION_FPS="${GENERATION_FPS:-30}"
# Internal motion/event code reads MOTION_FPS.  Keep one authoritative rate for
# retargeting, Event-DB construction, training, routing and evaluation.
export MOTION_FPS="$GENERATION_FPS"

# -----------------------------------------------------------------------------
# Formal Source-Motion source-motion contract
# -----------------------------------------------------------------------------
export SOURCE_MOTION_NONROOT_POSITION_MODE=ignore
# Preserve measured source turns by default. `stabilize` remains an explicit
# cleaning ablation and still protects known turn/whirl source semantics.
export SOURCE_HEADING_MODE="${SOURCE_HEADING_MODE:-raw}"
export SOURCE_HEADING_PRESERVE_TURN_TOKENS="${SOURCE_HEADING_PRESERVE_TURN_TOKENS:-sogdian_whirl,sogdian,whirl,turning_climax,turning_flow,explicit_spin}"
export SOURCE_MOTION_ROOT_ORIENTATION_LOCK=1
export SOURCE_GRAVITY_HARD_FAIL=1
export BOUNDARY_TRANSITION_FAIL_ON_UNSAFE_BOUNDARY="${BOUNDARY_TRANSITION_FAIL_ON_UNSAFE_BOUNDARY:-1}"
export CONTACT_OBSERVATION_SPEED_MPS="${CONTACT_OBSERVATION_SPEED_MPS:-0.75}"
export CONTACT_IK_LOCK_SPEED_MPS="${CONTACT_IK_LOCK_SPEED_MPS:-0.36}"
export CONTACT_STATIC_SUPPORT_SPEED_MPS="${CONTACT_STATIC_SUPPORT_SPEED_MPS:-0.18}"
export CONTACT_SLIDING_MIN_SPEED_MPS="${CONTACT_SLIDING_MIN_SPEED_MPS:-0.15}"
export CONTACT_SLIDING_MIN_FOOT_TRAVEL_M="${CONTACT_SLIDING_MIN_FOOT_TRAVEL_M:-0.05}"
export CONTACT_SLIDING_MIN_ROOT_TRAVEL_M="${CONTACT_SLIDING_MIN_ROOT_TRAVEL_M:-0.045}"
export CONTACT_SLIDING_DIRECTION_COS_MIN="${CONTACT_SLIDING_DIRECTION_COS_MIN:-0.35}"
export CONTACT_SLIDING_ROOT_FOOT_RELATIVE_MAX_M="${CONTACT_SLIDING_ROOT_FOOT_RELATIVE_MAX_M:-0.18}"
export CHANG_E_SLIDING_SUPPORT_TOKENS="${CHANG_E_SLIDING_SUPPORT_TOKENS:-sogdian_whirl,lotus_steps,turning_travel,traveling_steps,alternating_or_pivot_support,alternating_foot_support}"
export SOURCE_RETARGET_FIT_RMSE_P95_MAX_M=0.18

# Validated Source-Heading absolute heading settings.
export SOURCE_HEADING_SMOOTH_SECONDS=0.35
export SOURCE_HEADING_BASELINE_SECONDS=3.0
export SOURCE_HEADING_MIN_DRIFT_DEG_S=3.5
export SOURCE_HEADING_MIN_PERSIST_SECONDS=2.0
export SOURCE_HEADING_SIGN_CONSISTENCY=0.72
export SOURCE_HEADING_MAX_BASELINE_VARIATION_DEG_S=20.0
export SOURCE_HEADING_MAX_CORRECTION_DEG_S=90.0

# Temporally stronger retargeting for local jitter, while retaining the same
# keypoint/gravity constraints.  These are retraining/rebuild settings.
export SOURCE_RETARGET_FPS="${SOURCE_RETARGET_FPS:-$GENERATION_FPS}"
export SOURCE_RETARGET_CHUNK=256
export SOURCE_RETARGET_OVERLAP=64
export SOURCE_RETARGET_ITERS=120
export SOURCE_RETARGET_LR=0.025
export SOURCE_RETARGET_VEL_W=0.22
export SOURCE_RETARGET_ACC_W=0.060
export SOURCE_RETARGET_KEYPOINT_W=30.0
export SOURCE_RETARGET_ROOT_W=8.0
export SOURCE_RETARGET_UPRIGHT_W=5.0

# -----------------------------------------------------------------------------
# Event-Heading event-heading DB contract
# -----------------------------------------------------------------------------
export EVENT_HEADING_REQUIRE_SOURCE_MOTION_CACHE=1
export EVENT_HEADING_DROP_RESET_OR_DRIFT=1
# The short window is diagnostic context. Event composition is anchored to the
# physical first-frame root yaw by physical_first_frame_yaw_zero_v1.
export EVENT_HEADING_ENTRY_HEADING_MEDIAN_SECONDS=0.15
export EVENT_HEADING_ENTRY_HEADING_P95_MAX_DEG=5.0
export EVENT_HEADING_GLOBAL_MAX_EVENT_SECONDS=6.0
export EVENT_HEADING_TURN_INTERVAL_SPEED_DEG_S=18.0
export EVENT_HEADING_MIN_TURN_INTERVAL_SECONDS=0.40
export EVENT_HEADING_TURN_EDGE_BOUNDARY_BONUS=0.45
export EVENT_HEADING_CUT_THROUGH_TURN_PENALTY=0.55

export EVENT_HEADING_BUDGET_POSE_CALM_DEG=30
export EVENT_HEADING_BUDGET_INSTRUMENT_DEG=45
export EVENT_HEADING_BUDGET_FOOTWORK_DEG=90
export EVENT_HEADING_BUDGET_AERIAL_TRANSITION_DEG=120
export EVENT_HEADING_BUDGET_DEFAULT_DEG=60
export EVENT_HEADING_BUDGET_TURN_DEG=360
export EVENT_HEADING_BUDGET_EXPLICIT_SPIN_DEG=540
export EVENT_HEADING_NON_TURN_HARD_EXCESS_MULTIPLIER=1.50
export EVENT_HEADING_RESET_MIN_SECONDS=1.5
export EVENT_HEADING_RESET_BUDGET_MULTIPLIER=1.20
export EVENT_HEADING_RESET_MONOTONICITY_MIN=0.62

# Planner-owned stage heading.
export EVENT_HEADING_STAGE_INITIAL_HEADING_DEG=0
export EVENT_HEADING_PLANNER_WEIGHT=0.85
export EVENT_HEADING_INTENT_MISMATCH_WEIGHT=1.0
export EVENT_HEADING_STAGE_FRONT_ANCHOR_WEIGHT=1.25
export EVENT_HEADING_CONSECUTIVE_TURN_PENALTY=0.75
export EVENT_HEADING_QUALITY_WEIGHT=0.75
export EVENT_HEADING_PROTECT_PLANNED_ROOT_HEADING=1
export EVENT_HEADING_PLANNED_HEADING_ERROR_P95_MAX_DEG=2.0

# Closed-loop boundary candidate budget.
export BOUNDARY_RESELECT_ENABLE=1
export BOUNDARY_MAX_RESELECT_ROUNDS=2
export BOUNDARY_RISK_ADAPT_TRANSITION_ENABLE=1

# Routing Safety: Scheduler and Generation must share one stable event identity space.
export ROUTING_SAFETY_REQUIRE_ALIGNED_EVENT_DB=1
export ROUTING_SAFETY_EVENT_COOLDOWN_SLOTS="${ROUTING_SAFETY_EVENT_COOLDOWN_SLOTS:-8}"
export ROUTING_SAFETY_MAX_SOURCE_RUN="${ROUTING_SAFETY_MAX_SOURCE_RUN:-2}"
export ROUTING_SAFETY_MAX_SOURCE_SHARE="${ROUTING_SAFETY_MAX_SOURCE_SHARE:-0.40}"
export ROUTING_SAFETY_MAX_RECORDING_SHARE="${ROUTING_SAFETY_MAX_RECORDING_SHARE:-$ROUTING_SAFETY_MAX_SOURCE_SHARE}"
export ROUTING_SAFETY_MAX_FAMILY_SHARE="${ROUTING_SAFETY_MAX_FAMILY_SHARE:-0.50}"
export ROUTING_SAFETY_MIN_SHARE_HISTORY="${ROUTING_SAFETY_MIN_SHARE_HISTORY:-6}"
export ROUTING_SAFETY_MAX_TRANSITION_MASK_RATIO="${ROUTING_SAFETY_MAX_TRANSITION_MASK_RATIO:-0.25}"

# Physical commit gate. Failed motion is not rendered or admitted as a result.
export ROUTING_SAFETY_REQUIRE_FINAL_PHYSICAL_GATE=1
export ROUTING_SAFETY_FINAL_PHYSICAL_ROLLBACK="${ROUTING_SAFETY_FINAL_PHYSICAL_ROLLBACK:-1}"
export ROUTING_SAFETY_MAX_FOOT_SKATE_P95_MPS="${ROUTING_SAFETY_MAX_FOOT_SKATE_P95_MPS:-0.18}"
export ROUTING_SAFETY_MAX_FOOT_SKATE_MAX_MPS="${ROUTING_SAFETY_MAX_FOOT_SKATE_MAX_MPS:-0.60}"
