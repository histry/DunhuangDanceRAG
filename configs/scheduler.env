export ROUTING_SAFETY_MAX_FOOT_SUPPORT_DRIFT_MAX_M="${ROUTING_SAFETY_MAX_FOOT_SUPPORT_DRIFT_MAX_M:-0.12}"
export ROUTING_SAFETY_MAX_FOOT_CONTACT_HEIGHT_M="${ROUTING_SAFETY_MAX_FOOT_CONTACT_HEIGHT_M:-0.10}"
export ROUTING_SAFETY_MIN_FOOT_PENETRATION_M="${ROUTING_SAFETY_MIN_FOOT_PENETRATION_M:--0.050}"
export ROUTING_SAFETY_MAX_JOINT_JERK_P95_MPS3="${ROUTING_SAFETY_MAX_JOINT_JERK_P95_MPS3:-810.0}"
export ROUTING_SAFETY_MAX_JOINT_JERK_MAX_MPS3="${ROUTING_SAFETY_MAX_JOINT_JERK_MAX_MPS3:-1620.0}"
export ROUTING_SAFETY_MAX_JOINT_JERK_WINDOW_P95_MPS3="${ROUTING_SAFETY_MAX_JOINT_JERK_WINDOW_P95_MPS3:-1080.0}"
export ROUTING_SAFETY_MAX_EXTREMITY_JERK_P95_MPS3="${ROUTING_SAFETY_MAX_EXTREMITY_JERK_P95_MPS3:-810.0}"
export ROUTING_SAFETY_MAX_EXTREMITY_JERK_WINDOW_P95_MPS3="${ROUTING_SAFETY_MAX_EXTREMITY_JERK_WINDOW_P95_MPS3:-1080.0}"
export ROUTING_SAFETY_MAX_ROOT_Y_ROBUST_RANGE_M="${ROUTING_SAFETY_MAX_ROOT_Y_ROBUST_RANGE_M:-0.90}"
export ROUTING_SAFETY_MAX_ROOT_VERTICAL_SPEED_P95_MPS="${ROUTING_SAFETY_MAX_ROOT_VERTICAL_SPEED_P95_MPS:-1.25}"
export ROUTING_SAFETY_MAX_ROOT_VERTICAL_SPEED_MAX_MPS="${ROUTING_SAFETY_MAX_ROOT_VERTICAL_SPEED_MAX_MPS:-4.0}"
export ROUTING_SAFETY_MAX_ROOT_XZ_RADIUS_P95_M="${ROUTING_SAFETY_MAX_ROOT_XZ_RADIUS_P95_M:-1.80}"
export ROUTING_SAFETY_MAX_ROOT_XZ_RADIUS_MAX_M="${ROUTING_SAFETY_MAX_ROOT_XZ_RADIUS_MAX_M:-2.20}"
export ROUTING_SAFETY_MAX_ROOT_XZ_NET_DISPLACEMENT_M="${ROUTING_SAFETY_MAX_ROOT_XZ_NET_DISPLACEMENT_M:-3.00}"
export ROUTING_SAFETY_MAX_ROOT_XZ_DRIFT_SPEED_MPS="${ROUTING_SAFETY_MAX_ROOT_XZ_DRIFT_SPEED_MPS:-0.12}"
export ROUTING_SAFETY_MAX_ROOT_XZ_WINDOW_DISPLACEMENT_M="${ROUTING_SAFETY_MAX_ROOT_XZ_WINDOW_DISPLACEMENT_M:-1.50}"
# Whole-sequence SO(3) quality. These safety defaults remain provisional until
# recalibrated on the corrected 60->30 FPS training recording groups only.
export PHYSICAL_MAX_ROT6D_NONFINITE_RATIO="${PHYSICAL_MAX_ROT6D_NONFINITE_RATIO:-0.0}"
export PHYSICAL_MAX_ROT6D_DEGENERATE_RATIO="${PHYSICAL_MAX_ROT6D_DEGENERATE_RATIO:-0.0}"
export PHYSICAL_MAX_ROT6D_COLLINEARITY_P99="${PHYSICAL_MAX_ROT6D_COLLINEARITY_P99:-0.995}"
export PHYSICAL_MAX_ROTATION_NEAR_PI_STEP_RATIO="${PHYSICAL_MAX_ROTATION_NEAR_PI_STEP_RATIO:-0.0}"
export PHYSICAL_MAX_JOINT_ROTATION_STEP_P95_RAD="${PHYSICAL_MAX_JOINT_ROTATION_STEP_P95_RAD:-0.35}"
export PHYSICAL_MAX_JOINT_ROTATION_STEP_MAX_RAD="${PHYSICAL_MAX_JOINT_ROTATION_STEP_MAX_RAD:-1.20}"
export PHYSICAL_MAX_JOINT_ROTATION_STEP_WINDOW_P95_RAD="${PHYSICAL_MAX_JOINT_ROTATION_STEP_WINDOW_P95_RAD:-0.50}"
export PHYSICAL_MAX_EXTREMITY_ROTATION_STEP_P95_RAD="${PHYSICAL_MAX_EXTREMITY_ROTATION_STEP_P95_RAD:-0.45}"
export PHYSICAL_MAX_EXTREMITY_ROTATION_STEP_MAX_RAD="${PHYSICAL_MAX_EXTREMITY_ROTATION_STEP_MAX_RAD:-1.40}"
export PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_P95_RPS2="${PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_P95_RPS2:-900.0}"
export PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_MAX_RPS2="${PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_MAX_RPS2:-3000.0}"
export PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_WINDOW_P95_RPS2="${PHYSICAL_MAX_JOINT_ANGULAR_ACCEL_WINDOW_P95_RPS2:-1600.0}"
export ROUTING_SAFETY_RUN_PRETRAIN_REGRESSION="${ROUTING_SAFETY_RUN_PRETRAIN_REGRESSION:-1}"
export BOUNDARY_MAX_BOUNDARY_JERK_MPS3="${BOUNDARY_MAX_BOUNDARY_JERK_MPS3:-650}"
export BOUNDARY_REQUIRE_FINAL_BOUNDARY_GATE="${BOUNDARY_REQUIRE_FINAL_BOUNDARY_GATE:-1}"
export BOUNDARY_MAX_ENTRY_FK_JUMP_M="${BOUNDARY_MAX_ENTRY_FK_JUMP_M:-0.015}"
export BOUNDARY_MAX_EXIT_FK_JUMP_M="${BOUNDARY_MAX_EXIT_FK_JUMP_M:-0.015}"
export BOUNDARY_MAX_ENTRY_FK_JOINT_JUMP_M="${BOUNDARY_MAX_ENTRY_FK_JOINT_JUMP_M:-0.050}"
export BOUNDARY_MAX_EXIT_FK_JOINT_JUMP_M="${BOUNDARY_MAX_EXIT_FK_JOINT_JUMP_M:-0.050}"
export BOUNDARY_MAX_ENTRY_ROT_RAD="${BOUNDARY_MAX_ENTRY_ROT_RAD:-0.08}"
export BOUNDARY_MAX_EXIT_ROT_RAD="${BOUNDARY_MAX_EXIT_ROT_RAD:-0.08}"
export BOUNDARY_MAX_FOOT_SLIP_MPS="${BOUNDARY_MAX_FOOT_SLIP_MPS:-0.06}"
export BOUNDARY_MAX_FOOT_SLIP_P95_MPS="${BOUNDARY_MAX_FOOT_SLIP_P95_MPS:-0.12}"
export BOUNDARY_MAX_FOOT_SLIP_PEAK_MPS="${BOUNDARY_MAX_FOOT_SLIP_PEAK_MPS:-0.25}"
export BOUNDARY_MAX_FOOT_PENETRATION_M2="${BOUNDARY_MAX_FOOT_PENETRATION_M2:-0.001}"
export BOUNDARY_MAX_FOOT_PENETRATION_DEPTH_M="${BOUNDARY_MAX_FOOT_PENETRATION_DEPTH_M:-0.040}"

# Strong-reference principle: real cultural event cores stay dominant.
export MOTION_REFINER_CORE_STRENGTH=0.02
export MOTION_DIFFUSION_CORE_STRENGTH=0.00
export MOTION_DIFFUSION_TRANSITION_STRENGTH=0.25
export MOTION_TRANSITION_BUDGET_ENABLE=1
export MOTION_TRANSITION_INBETWEEN_ENABLE=1
export MOTION_ENABLE_TRUE_IK=1
export MOTION_ENABLE_ROOT_Y_PHYSICS=0
export MOTION_IK_POST_STABILIZE_ENABLE=1
export MOTION_IK_POST_STABILIZE_PASSES=2
export MOTION_IK_COMMIT_JERK_P95_MAX_MPS3=810.0
export MOTION_IK_COMMIT_JERK_MAX_MPS3=1620.0
export MOTION_IK_COMMIT_ROOT_DELTA_MAX_M=0.12
export MOTION_ENABLE_REFINER=1
export MOTION_ENABLE_DIFFUSION=1
export MOTION_FINAL_PHYSICAL_GATE_ENABLE=1
export MOTION_FINAL_PHYSICAL_GATE_FAIL_CLOSED=1
export MOTION_FINAL_PHYSICAL_GATE_SAVE_REJECTED=1
export PHYSICS_STABILITY_MSA_MAX_CORRECTION_VEL_MPS="${PHYSICS_STABILITY_MSA_MAX_CORRECTION_VEL_MPS:-0.18}"

# Strict MSSD semantics remain enabled inside the current Motion Generation core. Fresh-Audio Generation
# additionally verifies current-WAV provenance before delegation.
export MOTION_MSSD_ENABLE=1
export MOTION_MSSD_REQUIRE_FINAL_SCHEDULE_FOR_GENERATE=1

# -----------------------------------------------------------------------------
# Fresh-WAV audio–schedule transaction
# -----------------------------------------------------------------------------
export GENERATION_REQUIRE_FRESH_WAV_SCHEDULE=1
export GENERATION_ALLOW_SCHEDULE_REUSE=0
export GENERATION_MAX_FRAME_ERROR=2
export GENERATION_MAX_SECONDS_ERROR=0.10

# Every WAV gets a new Music Router, Whole-Song Planner, and Duration Model schedule transaction.  No SLOTS_JSON input is
# used by the formal scripts.
export GENERATION_FORCE_RESCHEDULE_EACH_GENERATION=1
export GENERATION_UNIQUE_FEATURE_CACHE=1

# Music scheduling policy.
export GENERATION_MIN_PHRASE_SECONDS="${GENERATION_MIN_PHRASE_SECONDS:-2.5}"
export GENERATION_MAX_PHRASE_SECONDS="${GENERATION_MAX_PHRASE_SECONDS:-7.5}"
export GENERATION_MAX_SINGLE_EVENT_SECONDS="${GENERATION_MAX_SINGLE_EVENT_SECONDS:-5.00}"
export GENERATION_CALM_MAX_SINGLE_EVENT_SECONDS="${GENERATION_CALM_MAX_SINGLE_EVENT_SECONDS:-4.50}"
export GENERATION_MIN_SUBPHRASE_SECONDS="${GENERATION_MIN_SUBPHRASE_SECONDS:-2.50}"
export GENERATION_MAX_EVENTS_PER_PHRASE="${GENERATION_MAX_EVENTS_PER_PHRASE:-2}"
export GENERATION_TRANSITION_MIN_FRAMES="${GENERATION_TRANSITION_MIN_FRAMES:-8}"
export GENERATION_TRANSITION_MAX_FRAMES="${GENERATION_TRANSITION_MAX_FRAMES:-24}"
export GENERATION_MAX_TRANSITION_FRACTION="${GENERATION_MAX_TRANSITION_FRACTION:-0.20}"
export GENERATION_TRANSITION_BUDGET_MIN_FRAMES="${GENERATION_TRANSITION_BUDGET_MIN_FRAMES:-6}"
export GENERATION_BOUNDARY_QUANTILE="${GENERATION_BOUNDARY_QUANTILE:-0.68}"
export GENERATION_BEAT_SNAP_SECONDS="${GENERATION_BEAT_SNAP_SECONDS:-0.35}"
export GENERATION_SLOT_BEAT_SNAP_SECONDS="${GENERATION_SLOT_BEAT_SNAP_SECONDS:-0.25}"
export GENERATION_MAX_PHRASES="${GENERATION_MAX_PHRASES:-96}"
export GENERATION_BEAM_SIZE="${GENERATION_BEAM_SIZE:-24}"
export GENERATION_CANDIDATE_TOP_K="${GENERATION_CANDIDATE_TOP_K:-256}"
export GENERATION_GRAPH_NODE_TOP_K="${GENERATION_GRAPH_NODE_TOP_K:-96}"

# Music-label-independent schedule hard gates. Occupancy is measured on the
# selected motion Event's allocated core frames, never on music semantics.
export GENERATION_MAX_POSE_HOLD_RATIO="${GENERATION_MAX_POSE_HOLD_RATIO:-0.25}"
export GENERATION_MIN_UNIQUE_EVENTS="${GENERATION_MIN_UNIQUE_EVENTS:-4}"
export GENERATION_MIN_CORE_FRAME_RATIO="${GENERATION_MIN_CORE_FRAME_RATIO:-0.80}"

# Routing Safety product-state edge cost and geometry contracts.  These values are
# forwarded explicitly into the Fresh-WAV scheduler and are shared with the
# Stage-13 closed-loop assembler below.
export ROUTING_SAFETY_PHYSICAL_EDGE_WEIGHT="${ROUTING_SAFETY_PHYSICAL_EDGE_WEIGHT:-0.55}"
export ROUTING_SAFETY_PHYSICAL_EDGE_HARD_PRUNE="${ROUTING_SAFETY_PHYSICAL_EDGE_HARD_PRUNE:-1}"
export ROUTING_SAFETY_PHYSICAL_EDGE_RESET_ACCENT="${ROUTING_SAFETY_PHYSICAL_EDGE_RESET_ACCENT:-0.82}"
export ROUTING_SAFETY_ROOT_HEIGHT_GAP_REFERENCE_M="${ROUTING_SAFETY_ROOT_HEIGHT_GAP_REFERENCE_M:-0.18}"
export ROUTING_SAFETY_ROOT_HEIGHT_GAP_HARD_M="${ROUTING_SAFETY_ROOT_HEIGHT_GAP_HARD_M:-0.55}"
export ROUTING_SAFETY_POSTURE_STATE_GAP_HARD="${ROUTING_SAFETY_POSTURE_STATE_GAP_HARD:-2}"
export ROUTING_SAFETY_FLOOR_GAP_REFERENCE_M="${ROUTING_SAFETY_FLOOR_GAP_REFERENCE_M:-0.08}"
export ROUTING_SAFETY_FLOOR_GAP_HARD_M="${ROUTING_SAFETY_FLOOR_GAP_HARD_M:-0.20}"
export ROUTING_SAFETY_ROOT_VELOCITY_JUMP_REFERENCE_MPS="${ROUTING_SAFETY_ROOT_VELOCITY_JUMP_REFERENCE_MPS:-0.80}"
export ROUTING_SAFETY_ROOT_VELOCITY_JUMP_HARD_MPS="${ROUTING_SAFETY_ROOT_VELOCITY_JUMP_HARD_MPS:-2.0}"
export ROUTING_SAFETY_CONTACT_GAP_HARD="${ROUTING_SAFETY_CONTACT_GAP_HARD:-0.75}"
export ROUTING_SAFETY_STAGE_FLOOR_Y="${ROUTING_SAFETY_STAGE_FLOOR_Y:-0.0}"
export ROUTING_SAFETY_EVENT_FLOOR_QUANTILE="${ROUTING_SAFETY_EVENT_FLOOR_QUANTILE:-5.0}"
export ROUTING_SAFETY_EVENT_MAX_FLOOR_PENETRATION_M="${ROUTING_SAFETY_EVENT_MAX_FLOOR_PENETRATION_M:-0.005}"
export ROUTING_SAFETY_TRANSITION_ANGULAR_SPEED_CAP_RADPS="${ROUTING_SAFETY_TRANSITION_ANGULAR_SPEED_CAP_RADPS:-8.0}"
export ROUTING_SAFETY_TRANSITION_ROOT_XZ_SPEED_CAP_MPS="${ROUTING_SAFETY_TRANSITION_ROOT_XZ_SPEED_CAP_MPS:-1.5}"
export ROUTING_SAFETY_TRANSITION_ROOT_Y_SPEED_CAP_MPS="${ROUTING_SAFETY_TRANSITION_ROOT_Y_SPEED_CAP_MPS:-0.9}"
export ROUTING_SAFETY_TRANSITION_ROOT_TANGENT_MARGIN_M="${ROUTING_SAFETY_TRANSITION_ROOT_TANGENT_MARGIN_M:-0.12}"
export ROUTING_SAFETY_TRANSITION_FLOOR_CLEARANCE_M="${ROUTING_SAFETY_TRANSITION_FLOOR_CLEARANCE_M:-0.002}"
export ROUTING_SAFETY_TRANSITION_FLOOR_SMOOTH_SECONDS="${ROUTING_SAFETY_TRANSITION_FLOOR_SMOOTH_SECONDS:-0.166666667}"
export ROUTING_SAFETY_TRANSITION_CONTACT_RAMP_SECONDS="${ROUTING_SAFETY_TRANSITION_CONTACT_RAMP_SECONDS:-0.133333333}"
export RETARGET_FLOOR_GAP_SAFE_M="${RETARGET_FLOOR_GAP_SAFE_M:-0.15}"
export RETARGET_FLOOR_GAP_HARD_M="${RETARGET_FLOOR_GAP_HARD_M:-0.20}"
export RETARGET_ROOT_VELOCITY_GAP_SAFE_MPS="${RETARGET_ROOT_VELOCITY_GAP_SAFE_MPS:-1.25}"
export RETARGET_ROOT_VELOCITY_GAP_HARD_MPS="${RETARGET_ROOT_VELOCITY_GAP_HARD_MPS:-2.0}"

# Rhythm extraction is a strict schedule dependency. Deep-music settings live
# in the research fragment so each variable has exactly one owner.
export GENERATION_REQUIRE_RHYTHM_FEATURES="${GENERATION_REQUIRE_RHYTHM_FEATURES:-1}"

export REFINER_STEPS="${REFINER_STEPS:-8000}"
export MOTION_STEPS="${MOTION_STEPS:-15000}"
export MOTION_DIFFUSION_STEPS="${MOTION_DIFFUSION_STEPS:-50}"

# -----------------------------------------------------------------------------
# Default local paths
# -----------------------------------------------------------------------------
export CONFIG="${CONFIG:-configs/motion_model.json}"
