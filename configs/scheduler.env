# =============================================================================
# V46.51 Fresh-WAV Schedule Transaction + V46.50 Event Heading
# =============================================================================
# Internal scheduler fragment. Source configs/experiment.env, never this file.

_PROJECT_ROOT="${ROOT_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export EDGE_ROOT="$_PROJECT_ROOT"
export PYTHONPATH="$_PROJECT_ROOT"
unset _PROJECT_ROOT
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export V46_DEVICE="${V46_DEVICE:-cuda}"
export V46_49_RETARGET_DEVICE="${V46_49_RETARGET_DEVICE:-cuda}"
# One externally selectable canonical rate drives both retargeting and scheduling.
export V46_51_FPS="${V46_51_FPS:-30}"
# Internal motion/event code reads V46_FPS.  Keep one authoritative rate for
# retargeting, Event-DB construction, training, routing and evaluation.
export V46_FPS="$V46_51_FPS"

# -----------------------------------------------------------------------------
# Formal V46.49.4 source-motion contract
# -----------------------------------------------------------------------------
export V46_49_NONROOT_POSITION_MODE=ignore
export V46_49_HEADING_MODE=stabilize
export V46_49_ROOT_ORIENTATION_LOCK=1
export V46_49_GRAVITY_HARD_FAIL=1
export V46_49_FIT_RMSE_P95_MAX_M=0.18

# Validated V46.49.3b absolute heading settings.
export V46_49_HEADING_SMOOTH_SECONDS=0.35
export V46_49_HEADING_BASELINE_SECONDS=3.0
export V46_49_HEADING_MIN_DRIFT_DEG_S=3.5
export V46_49_HEADING_MIN_PERSIST_SECONDS=2.0
export V46_49_HEADING_SIGN_CONSISTENCY=0.72
export V46_49_HEADING_MAX_BASELINE_VARIATION_DEG_S=20.0
export V46_49_HEADING_MAX_CORRECTION_DEG_S=90.0

# Temporally stronger retargeting for local jitter, while retaining the same
# keypoint/gravity constraints.  These are retraining/rebuild settings.
export V46_49_RETARGET_FPS="${V46_49_RETARGET_FPS:-$V46_51_FPS}"
export V46_49_RETARGET_CHUNK=256
export V46_49_RETARGET_OVERLAP=64
export V46_49_RETARGET_ITERS=120
export V46_49_RETARGET_LR=0.025
export V46_49_RETARGET_VEL_W=0.22
export V46_49_RETARGET_ACC_W=0.060
export V46_49_RETARGET_KEYPOINT_W=30.0
export V46_49_RETARGET_ROOT_W=8.0
export V46_49_RETARGET_UPRIGHT_W=5.0

# -----------------------------------------------------------------------------
# V46.50 event-heading DB contract
# -----------------------------------------------------------------------------
export V46_50_REQUIRE_V46_49_4_CACHE=1
export V46_50_DROP_RESET_OR_DRIFT=1
export V46_50_ENTRY_HEADING_MEDIAN_SECONDS=0.15
export V46_50_ENTRY_HEADING_P95_MAX_DEG=5.0
export V46_50_GLOBAL_MAX_EVENT_SECONDS=6.0
export V46_50_TURN_INTERVAL_SPEED_DEG_S=18.0
export V46_50_MIN_TURN_INTERVAL_SECONDS=0.40
export V46_50_TURN_EDGE_BOUNDARY_BONUS=0.45
export V46_50_CUT_THROUGH_TURN_PENALTY=0.55

export V46_50_BUDGET_POSE_CALM_DEG=30
export V46_50_BUDGET_INSTRUMENT_DEG=45
export V46_50_BUDGET_FOOTWORK_DEG=90
export V46_50_BUDGET_AERIAL_TRANSITION_DEG=120
export V46_50_BUDGET_DEFAULT_DEG=60
export V46_50_BUDGET_TURN_DEG=360
export V46_50_BUDGET_EXPLICIT_SPIN_DEG=540
export V46_50_NON_TURN_HARD_EXCESS_MULTIPLIER=1.50
export V46_50_RESET_MIN_SECONDS=1.5
export V46_50_RESET_BUDGET_MULTIPLIER=1.20
export V46_50_RESET_MONOTONICITY_MIN=0.62

# Planner-owned stage heading.
export V46_50_STAGE_INITIAL_HEADING_DEG=0
export V46_50_HEADING_PLANNER_WEIGHT=0.85
export V46_50_INTENT_MISMATCH_WEIGHT=1.0
export V46_50_STAGE_FRONT_ANCHOR_WEIGHT=1.25
export V46_50_CONSECUTIVE_TURN_PENALTY=0.75
export V46_50_HEADING_QUALITY_WEIGHT=0.75
export V46_50_PROTECT_PLANNED_ROOT_HEADING=1
export V46_50_PLANNED_HEADING_ERROR_P95_MAX_DEG=2.0

# Closed-loop boundary candidate budget.
export V46_46_RESELECT_ENABLE=1
export V46_46_MAX_RESELECT_ROUNDS=2
export V46_46_RISK_ADAPT_TRANSITION_ENABLE=1

# V46.54: Scheduler and Generation must share one stable event identity space.
export V46_54_REQUIRE_ALIGNED_EVENT_DB=1
export V46_54_EVENT_COOLDOWN_SLOTS="${V46_54_EVENT_COOLDOWN_SLOTS:-8}"
export V46_54_MAX_SOURCE_RUN="${V46_54_MAX_SOURCE_RUN:-2}"
export V46_54_MAX_SOURCE_SHARE="${V46_54_MAX_SOURCE_SHARE:-0.40}"
export V46_54_MAX_FAMILY_SHARE="${V46_54_MAX_FAMILY_SHARE:-0.50}"
export V46_54_MIN_SHARE_HISTORY="${V46_54_MIN_SHARE_HISTORY:-6}"
export V46_54_MAX_TRANSITION_MASK_RATIO="${V46_54_MAX_TRANSITION_MASK_RATIO:-0.25}"

# Physical commit gate. Failed motion is not rendered or admitted as a result.
export V46_54_REQUIRE_FINAL_PHYSICAL_GATE=1
export V46_54_FINAL_PHYSICAL_ROLLBACK="${V46_54_FINAL_PHYSICAL_ROLLBACK:-1}"
export V46_54_MAX_FOOT_SKATE_P95_MPS="${V46_54_MAX_FOOT_SKATE_P95_MPS:-0.18}"
export V46_54_MAX_FOOT_SKATE_MAX_MPS="${V46_54_MAX_FOOT_SKATE_MAX_MPS:-0.60}"
export V46_54_MAX_FOOT_SUPPORT_DRIFT_P95_M="${V46_54_MAX_FOOT_SUPPORT_DRIFT_P95_M:-0.06}"
export V46_54_MAX_FOOT_SUPPORT_DRIFT_MAX_M="${V46_54_MAX_FOOT_SUPPORT_DRIFT_MAX_M:-0.12}"
export V46_54_MAX_FOOT_CONTACT_HEIGHT_M="${V46_54_MAX_FOOT_CONTACT_HEIGHT_M:-0.10}"
export V46_54_MIN_FOOT_PENETRATION_M="${V46_54_MIN_FOOT_PENETRATION_M:--0.050}"
export V46_54_MAX_JOINT_JERK_P95_MPS3="${V46_54_MAX_JOINT_JERK_P95_MPS3:-810.0}"
export V46_54_MAX_JOINT_JERK_MAX_MPS3="${V46_54_MAX_JOINT_JERK_MAX_MPS3:-1620.0}"
export V46_54_MAX_JOINT_JERK_WINDOW_P95_MPS3="${V46_54_MAX_JOINT_JERK_WINDOW_P95_MPS3:-1080.0}"
export V46_54_MAX_EXTREMITY_JERK_P95_MPS3="${V46_54_MAX_EXTREMITY_JERK_P95_MPS3:-810.0}"
export V46_54_MAX_EXTREMITY_JERK_WINDOW_P95_MPS3="${V46_54_MAX_EXTREMITY_JERK_WINDOW_P95_MPS3:-1080.0}"
export V46_54_MAX_ROOT_Y_ROBUST_RANGE_M="${V46_54_MAX_ROOT_Y_ROBUST_RANGE_M:-0.90}"
export V46_54_MAX_ROOT_VERTICAL_SPEED_P95_MPS="${V46_54_MAX_ROOT_VERTICAL_SPEED_P95_MPS:-1.25}"
export V46_54_MAX_ROOT_VERTICAL_SPEED_MAX_MPS="${V46_54_MAX_ROOT_VERTICAL_SPEED_MAX_MPS:-4.0}"
export V46_54_MAX_ROOT_XZ_RADIUS_P95_M="${V46_54_MAX_ROOT_XZ_RADIUS_P95_M:-1.80}"
export V46_54_MAX_ROOT_XZ_RADIUS_MAX_M="${V46_54_MAX_ROOT_XZ_RADIUS_MAX_M:-2.20}"
export V46_54_MAX_ROOT_XZ_NET_DISPLACEMENT_M="${V46_54_MAX_ROOT_XZ_NET_DISPLACEMENT_M:-3.00}"
export V46_54_MAX_ROOT_XZ_DRIFT_SPEED_MPS="${V46_54_MAX_ROOT_XZ_DRIFT_SPEED_MPS:-0.12}"
export V46_54_MAX_ROOT_XZ_WINDOW_DISPLACEMENT_M="${V46_54_MAX_ROOT_XZ_WINDOW_DISPLACEMENT_M:-1.50}"
export V46_54_RUN_PRETRAIN_REGRESSION="${V46_54_RUN_PRETRAIN_REGRESSION:-1}"
export V46_46_MAX_BOUNDARY_JERK_MPS3="${V46_46_MAX_BOUNDARY_JERK_MPS3:-650}"
export V46_46_REQUIRE_FINAL_BOUNDARY_GATE="${V46_46_REQUIRE_FINAL_BOUNDARY_GATE:-1}"
export V46_46_MAX_ENTRY_FK_JUMP_M="${V46_46_MAX_ENTRY_FK_JUMP_M:-0.015}"
export V46_46_MAX_EXIT_FK_JUMP_M="${V46_46_MAX_EXIT_FK_JUMP_M:-0.015}"
export V46_46_MAX_ENTRY_ROT_RAD="${V46_46_MAX_ENTRY_ROT_RAD:-0.08}"
export V46_46_MAX_EXIT_ROT_RAD="${V46_46_MAX_EXIT_ROT_RAD:-0.08}"
export V46_46_MAX_FOOT_SLIP_MPS="${V46_46_MAX_FOOT_SLIP_MPS:-0.06}"
export V46_46_MAX_FOOT_PENETRATION_M2="${V46_46_MAX_FOOT_PENETRATION_M2:-0.001}"

# Strong-reference principle: real cultural event cores stay dominant.
export V46_REFINER_CORE_STRENGTH=0.02
export V46_DIFFUSION_CORE_STRENGTH=0.00
export V46_DIFFUSION_TRANSITION_STRENGTH=0.25
export V46_TRANSITION_BUDGET_ENABLE=1
export V46_TRANSITION_INBETWEEN_ENABLE=1
export V46_ENABLE_TRUE_IK=1
export V46_ENABLE_ROOT_Y_PHYSICS=0
export V46_IK_POST_STABILIZE_ENABLE=1
export V46_IK_POST_STABILIZE_PASSES=2
export V46_IK_COMMIT_JERK_P95_MAX_MPS3=810.0
export V46_IK_COMMIT_JERK_MAX_MPS3=1620.0
export V46_IK_COMMIT_ROOT_DELTA_MAX_M=0.12
export V46_ENABLE_REFINER=1
export V46_ENABLE_DIFFUSION=1

# Strict MSSD semantics remain enabled inside the current V46 core. V46.51
# additionally verifies current-WAV provenance before delegation.
export V46_MSSD_ENABLE=1
export V46_MSSD_REQUIRE_FINAL_SCHEDULE_FOR_GENERATE=1
export V46_REQUIRE_PRETRAINED_ROUTER_SLOTS=1

# -----------------------------------------------------------------------------
# V46.51 Fresh-WAV Audio–Schedule Transaction
# -----------------------------------------------------------------------------
export V46_51_REQUIRE_FRESH_WAV_SCHEDULE=1
export V46_51_ALLOW_SCHEDULE_REUSE=0
export V46_51_MAX_FRAME_ERROR=2
export V46_51_MAX_SECONDS_ERROR=0.10

# Every WAV gets a new V21/V26/V23 schedule transaction.  No SLOTS_JSON input is
# used by the formal scripts.
export V46_51_FORCE_RESCHEDULE_EACH_GENERATION=1
export V46_51_UNIQUE_FEATURE_CACHE=1

# Music scheduling policy.
export V46_51_MIN_PHRASE_SECONDS="${V46_51_MIN_PHRASE_SECONDS:-2.5}"
export V46_51_MAX_PHRASE_SECONDS="${V46_51_MAX_PHRASE_SECONDS:-7.5}"
export V46_51_MAX_SINGLE_EVENT_SECONDS="${V46_51_MAX_SINGLE_EVENT_SECONDS:-5.00}"
export V46_51_CALM_MAX_SINGLE_EVENT_SECONDS="${V46_51_CALM_MAX_SINGLE_EVENT_SECONDS:-4.50}"
export V46_51_MIN_SUBPHRASE_SECONDS="${V46_51_MIN_SUBPHRASE_SECONDS:-2.50}"
export V46_51_MAX_EVENTS_PER_PHRASE="${V46_51_MAX_EVENTS_PER_PHRASE:-2}"
export V46_51_TRANSITION_MIN_FRAMES="${V46_51_TRANSITION_MIN_FRAMES:-8}"
export V46_51_TRANSITION_MAX_FRAMES="${V46_51_TRANSITION_MAX_FRAMES:-24}"
export V46_51_MAX_TRANSITION_FRACTION="${V46_51_MAX_TRANSITION_FRACTION:-0.20}"
export V46_51_TRANSITION_BUDGET_MIN_FRAMES="${V46_51_TRANSITION_BUDGET_MIN_FRAMES:-6}"
export V46_51_BOUNDARY_QUANTILE="${V46_51_BOUNDARY_QUANTILE:-0.68}"
export V46_51_BEAT_SNAP_SECONDS="${V46_51_BEAT_SNAP_SECONDS:-0.35}"
export V46_51_SLOT_BEAT_SNAP_SECONDS="${V46_51_SLOT_BEAT_SNAP_SECONDS:-0.25}"
export V46_51_MAX_PHRASES="${V46_51_MAX_PHRASES:-96}"
export V46_51_BEAM_SIZE="${V46_51_BEAM_SIZE:-24}"
export V46_51_CANDIDATE_TOP_K="${V46_51_CANDIDATE_TOP_K:-256}"
export V46_51_GRAPH_NODE_TOP_K="${V46_51_GRAPH_NODE_TOP_K:-96}"

# Music-label-independent schedule hard gates. Occupancy is measured on the
# selected motion Event's allocated core frames, never on music semantics.
export V46_51_MAX_POSE_HOLD_RATIO="${V46_51_MAX_POSE_HOLD_RATIO:-0.25}"
export V46_51_MIN_UNIQUE_EVENTS="${V46_51_MIN_UNIQUE_EVENTS:-4}"
export V46_51_MIN_CORE_FRAME_RATIO="${V46_51_MIN_CORE_FRAME_RATIO:-0.80}"

# V46.54 product-state edge cost and geometry contracts.  These values are
# forwarded explicitly into the Fresh-WAV scheduler and are shared with the
# Stage-13 closed-loop assembler below.
export V46_54_PHYSICAL_EDGE_WEIGHT="${V46_54_PHYSICAL_EDGE_WEIGHT:-0.55}"
export V46_54_PHYSICAL_EDGE_HARD_PRUNE="${V46_54_PHYSICAL_EDGE_HARD_PRUNE:-1}"
export V46_54_PHYSICAL_EDGE_RESET_ACCENT="${V46_54_PHYSICAL_EDGE_RESET_ACCENT:-0.82}"
export V46_54_ROOT_HEIGHT_GAP_REFERENCE_M="${V46_54_ROOT_HEIGHT_GAP_REFERENCE_M:-0.18}"
export V46_54_ROOT_HEIGHT_GAP_HARD_M="${V46_54_ROOT_HEIGHT_GAP_HARD_M:-0.55}"
export V46_54_POSTURE_STATE_GAP_HARD="${V46_54_POSTURE_STATE_GAP_HARD:-2}"
export V46_54_FLOOR_GAP_REFERENCE_M="${V46_54_FLOOR_GAP_REFERENCE_M:-0.08}"
export V46_54_FLOOR_GAP_HARD_M="${V46_54_FLOOR_GAP_HARD_M:-0.20}"
export V46_54_ROOT_VELOCITY_JUMP_REFERENCE_MPS="${V46_54_ROOT_VELOCITY_JUMP_REFERENCE_MPS:-0.80}"
export V46_54_ROOT_VELOCITY_JUMP_HARD_MPS="${V46_54_ROOT_VELOCITY_JUMP_HARD_MPS:-2.0}"
export V46_54_CONTACT_GAP_HARD="${V46_54_CONTACT_GAP_HARD:-0.75}"
export V46_54_STAGE_FLOOR_Y="${V46_54_STAGE_FLOOR_Y:-0.0}"
export V46_54_EVENT_FLOOR_QUANTILE="${V46_54_EVENT_FLOOR_QUANTILE:-5.0}"
export V46_54_EVENT_MAX_FLOOR_PENETRATION_M="${V46_54_EVENT_MAX_FLOOR_PENETRATION_M:-0.005}"
export V46_54_TRANSITION_ANGULAR_SPEED_CAP_RADPS="${V46_54_TRANSITION_ANGULAR_SPEED_CAP_RADPS:-8.0}"
export V46_54_TRANSITION_ROOT_XZ_SPEED_CAP_MPS="${V46_54_TRANSITION_ROOT_XZ_SPEED_CAP_MPS:-1.5}"
export V46_54_TRANSITION_ROOT_Y_SPEED_CAP_MPS="${V46_54_TRANSITION_ROOT_Y_SPEED_CAP_MPS:-0.9}"
export V46_54_TRANSITION_ROOT_TANGENT_MARGIN_M="${V46_54_TRANSITION_ROOT_TANGENT_MARGIN_M:-0.12}"
export V46_54_TRANSITION_FLOOR_CLEARANCE_M="${V46_54_TRANSITION_FLOOR_CLEARANCE_M:-0.002}"
export V46_54_TRANSITION_FLOOR_SMOOTH_SECONDS="${V46_54_TRANSITION_FLOOR_SMOOTH_SECONDS:-0.166666667}"
export V46_54_TRANSITION_CONTACT_RAMP_SECONDS="${V46_54_TRANSITION_CONTACT_RAMP_SECONDS:-0.133333333}"
export V46_52_FLOOR_GAP_SAFE_M="${V46_52_FLOOR_GAP_SAFE_M:-0.15}"
export V46_52_FLOOR_GAP_HARD_M="${V46_52_FLOOR_GAP_HARD_M:-0.20}"
export V46_52_ROOT_VELOCITY_GAP_SAFE_MPS="${V46_52_ROOT_VELOCITY_GAP_SAFE_MPS:-1.25}"
export V46_52_ROOT_VELOCITY_GAP_HARD_MPS="${V46_52_ROOT_VELOCITY_GAP_HARD_MPS:-2.0}"

# Rhythm extraction is a strict schedule dependency. Deep-music settings live
# in the research fragment so each variable has exactly one owner.
export V46_51_REQUIRE_RHYTHM_FEATURES="${V46_51_REQUIRE_RHYTHM_FEATURES:-1}"

# V26 transition diffusion can be enabled with an explicit checkpoint.
export V46_51_TRANSITION_DIFFUSION="${V46_51_TRANSITION_DIFFUSION:-0}"
export V46_51_TRANSITION_DIFFUSION_CKPT="${V46_51_TRANSITION_DIFFUSION_CKPT:-}"
export V46_51_TRANSITION_DIFFUSION_BLEND="${V46_51_TRANSITION_DIFFUSION_BLEND:-0.18}"
export V46_51_TRANSITION_DIFFUSION_STEPS="${V46_51_TRANSITION_DIFFUSION_STEPS:-32}"

export V44_EPOCHS="${V44_EPOCHS:-120}"
export V45_STEPS="${V45_STEPS:-8000}"
export V46_STEPS="${V46_STEPS:-15000}"
export V46_DIFFUSION_STEPS="${V46_DIFFUSION_STEPS:-50}"

# -----------------------------------------------------------------------------
# Default local paths
# -----------------------------------------------------------------------------
export CONFIG="${CONFIG:-configs/motion_model.json}"
