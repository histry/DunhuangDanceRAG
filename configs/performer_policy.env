# Internal performer fragment. Source configs/experiment.env, never this file.
# auto: choose one group once, then keep it fixed for the complete song.
# female / male: explicit fixed group.
# mixed: explicit mixed-source experiment with switch penalties.
# identity_mode=group preserves source diversity but does not claim the same
# dancer. fixed_source guarantees one captured track; fixed_dancer is allowed
# only when verified global dancer_id metadata exists.
export PERFORMER_GROUP="${PERFORMER_GROUP:-auto}"
export PERFORMER_IDENTITY_MODE="${PERFORMER_IDENTITY_MODE:-group}"
export PERFORMER_REQUIRE_SOLO_COMPATIBLE="${PERFORMER_REQUIRE_SOLO_COMPATIBLE:-1}"
export PERFORMER_ALLOW_IDENTITY_RESCUE="${PERFORMER_ALLOW_IDENTITY_RESCUE:-0}"
export PERFORMER_ALLOW_CROSS_GROUP_RESCUE="${PERFORMER_ALLOW_CROSS_GROUP_RESCUE:-0}"
export PERFORMER_FIXED_GROUP_SWITCH_PENALTY="${PERFORMER_FIXED_GROUP_SWITCH_PENALTY:-1000000}"
export PERFORMER_MIXED_SWITCH_PENALTY="${PERFORMER_MIXED_SWITCH_PENALTY:-2.0}"
